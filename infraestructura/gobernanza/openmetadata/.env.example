# Limites de memoria JVM ajustados para entorno local (Laptop)
OPENMETADATA_HEAP_OPTS=-Xms512m -Xmx768m
ES_JAVA_OPTS=-Xms512m -Xmx768m

# IPs fijas del Cluster Big Data (Red Movil Hotspot)
CLUSTER_KAFKA_IP=10.131.229.5
CLUSTER_KAFKA_PORT=9092
