# Puertos en el host
OM_PORT=8585
OM_ADMIN_PORT=8586
OM_PG_PORT=5433
OM_INGESTION_PORT=8587

# Base de datos interna de OpenMetadata
OM_PG_USER=openmetadata_user
OM_PG_PASSWORD=openmetadata_password
